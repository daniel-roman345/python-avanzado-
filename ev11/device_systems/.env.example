# Configuracion de device_systems (EV11)
# Copiar este archivo a `.env` y ajustar los valores.

# --- Base de datos ---
DATABASE_URL=sqlite:///./device_systems.db

# --- Seguridad / JWT ---
# Clave de firma del JWT. En produccion generar una cadena aleatoria de 64+ chars.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-para-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Origenes autorizados separados por coma. En desarrollo suelen ser localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
